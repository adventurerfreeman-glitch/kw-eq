name: Build Windows VST3
on:
  workflow_dispatch:
  push:
jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - name: Configure
        run: cmake -S . -B build -G "Visual Studio 17 2022" -A x64
      - name: Build
        run: cmake --build build --config Release --target KWTiltLeanEQ_VST3
      - name: Upload VST3
        uses: actions/upload-artifact@v4
        with:
          name: KW-Tilt-Lean-EQ-VST3-win64
          path: build/KWTiltLeanEQ_artefacts/Release/VST3/
